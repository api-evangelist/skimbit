              },
              {
                "name": "access_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "period",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_dir",
                "value": "",
                "type": "query"
              },
              {
                "name": "a_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "country_code",
                "value": "",
                "type": "query"
              },
              {
                "name": "audience_country_code",
                "value": "",
                "type": "query"
              },
              {
                "name": "vertical_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "product_search",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Insights into products trending across the Skimlinks network that the publisher has not yet featured. Click data updates hourly; sales information available for the past 7 and 30 days."
        },
        {
          "info": {
            "name": "Get products bought report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://products.skimapis.com/publisher/:publisher_id/product-report",
            "params": [
              {
                "name": "publisher_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "access_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_dir",
                "value": "",
                "type": "query"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query"
              },
              {
                "name": "product_search",
                "value": "",
                "type": "query"
              },
              {
                "name": "domain_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Insights about the products readers purchased after clicking through commerce content, including SKU, quantity, order value and revenue. Features data from Awin, CJ, Rakuten, Impact, Partnerize and Pepperjam networks only."
        }
      ]
    }
  ],
  "bundled": true
}