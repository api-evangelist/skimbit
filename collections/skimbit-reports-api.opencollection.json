{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skimlinks Merchant Commissions Reports API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_token",
      "value": "{{access_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
