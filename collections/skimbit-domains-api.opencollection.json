{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skimlinks Merchant Commissions Domains API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_token",
      "value": "{{access_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List merchant domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://merchants.skimapis.com/v4/publisher/:publisher_id/domains",
            "params": [
              {
                "name": "publisher_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "access_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the complete set of Skimlinks merchant domains available for the authenticated publisher."
        }
      ]
    }
  ],
  "bundled": true
}